{
  "name": "dsh-linux-shortcut",
  "version": "0.1.2",
  "description": "DeepSeek Harness 插件：让 Linux 上的网页端拥有 Windows / macOS 端那套内置快捷键。宿主半在首页 <head> 首部注入一行脚本，使浏览器在快捷键服务读取平台之前把自己报告为 Windows，内置键位表、设置页键帽与改键因此生效；设置页另有一行指示映射是否真的生效。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "shortcut",
    "keybinding",
    "keyboard",
    "linux"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/nohappiness/dsh-linux-shortcut.git"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "dsh": {
    "verifiedAgainst": "0.2.2-rc.1",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
